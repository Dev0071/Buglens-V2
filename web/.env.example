# Buglens Frontend Environment Variables
# Copy this file to .env.local for local development

# API Base URL (without /api suffix - backend routes include /api prefix)
# Examples:
#   Development: http://localhost:3000 (Vite proxy forwards /api/* requests)
#   Staging:     https://api.staging.buglens.co
#   Production:  https://api.buglens.com
# Do NOT include /api at the end - it's already in the backend route prefixes
VITE_API_URL=

# App Name (displayed in UI)
VITE_APP_NAME=Buglens

# App Version (shown in settings/footer)
VITE_APP_VERSION=0.1.0

# Enable React Query Devtools in development (automatically disabled in production)
# Set to "true" to enable, any other value to disable
VITE_ENABLE_DEVTOOLS=true

# Analytics tracking ID (optional)
# VITE_ANALYTICS_ID=

# Sentry Configuration
VITE_SENTRY_DSN=https://7e88d24b2ab4552003ac61022f0d6645@o4510676293517312.ingest.us.sentry.io/4510691114287104
# For sourcemap uploads, set SENTRY_AUTH_TOKEN in .env.sentry-build-plugin

# Feature flags (optional)
# VITE_FEATURE_DARK_MODE=true
# VITE_FEATURE_NOTIFICATIONS=true
