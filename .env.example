# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/buglens
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=buglens-cache
SECRETS_MANAGER_PREFIX=buglens/

# Authentication
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=

# Sentry (for dogfooding)
SENTRY_DSN=
SENTRY_WEBHOOK_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_SECRET_ID=
GITHUB_WEBHOOK_SECRET=

# Rate Limits (can override defaults)
RATE_LIMIT_FREE_EVENTS_PER_HOUR=100
RATE_LIMIT_FREE_RCA_JOBS_PER_DAY=50
RATE_LIMIT_FREE_LLM_TOKENS_PER_DAY=100000
