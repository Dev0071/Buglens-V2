# =============================================================================
# Buglens Environment Configuration
# =============================================================================
#
# SECURITY NOTICE:
# ---------------
# 1. NEVER commit actual secrets to version control
# 2. Use placeholder values in .env.example
# 3. Real secrets must be stored in:
#    - AWS Secrets Manager (production)
#    - Local .env file (development only, excluded from git)
# 4. Rotate all secrets immediately if exposed
# 5. See docs/SECRETS_ROTATION.md for rotation procedures
#
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_VERSION=1.0.0

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Database - PostgreSQL
# =============================================================================
# CONNECTION STRING FORMAT: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ROTATION: Every 90 days in production
DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5432/buglens
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# SSL: Set to false for local development, true for Heroku/production
DATABASE_SSL=false

# =============================================================================
# Redis Cache
# =============================================================================
# CONNECTION STRING FORMAT: redis://[:PASSWORD@]HOST:PORT[/DATABASE]
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3

# =============================================================================
# AWS Configuration
# =============================================================================
# ROTATION: AWS credentials should use IAM roles in production
# For development, rotate access keys every 90 days
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
S3_BUCKET_NAME=buglens-cache
SECRETS_MANAGER_PREFIX=buglens/

# =============================================================================
# Authentication Secrets
# =============================================================================
# JWT_SECRET: Generate with `openssl rand -hex 64`
# ROTATION: Every 90 days (coordinate with active sessions)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=7d

# Session Secret for Cookie Encryption
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# =============================================================================
# OpenAI API
# =============================================================================
# ROTATION: Rotate if compromised or annually
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# Sentry Integration (for error tracking & dogfooding)
# =============================================================================
# Backend error tracking - Get DSN from https://sentry.io/settings/buglens/projects/buglens-backend/keys/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Webhook secret for verifying Sentry event payloads (for testing Buglens itself)
# ROTATION: When webhook endpoint changes or annually
SENTRY_WEBHOOK_SECRET=CHANGE_ME_32_CHAR_HEX

# =============================================================================
# Slack Integration
# =============================================================================
# OAuth credentials from Slack App configuration
# ROTATION: Only if compromised
SLACK_CLIENT_ID=XXXXXXXXXXXX.XXXXXXXXXXXX
SLACK_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# GitHub App Integration
# =============================================================================
# GitHub App credentials for code access
# ROTATION: Private key annually or if compromised
GITHUB_APP_ID=123456
# Store private key in AWS Secrets Manager, not env
GITHUB_APP_PRIVATE_KEY_SECRET_ID=buglens/github-app-private-key
# Webhook secret for verifying GitHub payloads
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=CHANGE_ME_32_CHAR_HEX

# =============================================================================
# OAuth Providers (Social Login)
# =============================================================================

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=Iv1.XXXXXXXXXXXX
GITHUB_OAUTH_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# Enterprise Integrations
# =============================================================================

# Jira (Atlassian OAuth 2.0)
JIRA_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JIRA_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Microsoft Teams (Azure AD OAuth 2.0)
TEAMS_CLIENT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
TEAMS_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TEAMS_TENANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# =============================================================================
# Rate Limits (per organization tier)
# =============================================================================
RATE_LIMIT_FREE_EVENTS_PER_HOUR=100
RATE_LIMIT_FREE_RCA_JOBS_PER_DAY=50
RATE_LIMIT_FREE_LLM_TOKENS_PER_DAY=100000

# =============================================================================
# Admin Security
# =============================================================================
# Platform admin token for admin API access
# Generate with: openssl rand -hex 32
# ROTATION: Every 30 days
PLATFORM_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
