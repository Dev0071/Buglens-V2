# Buglens Staging Environment Template
# Use with Doppler or copy to .env.staging

# ============================================
# Core
# ============================================
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# ============================================
# Database (DigitalOcean Managed PostgreSQL)
# ============================================
DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-nyc1-xxxxx.ondigitalocean.com:25060/defaultdb?sslmode=require
# SSL enabled by default (required for Heroku/managed databases)
DATABASE_SSL=true

# ============================================
# Redis (DigitalOcean Managed Redis)
# ============================================
REDIS_URL=rediss://default:PASSWORD@redis-xxxxx.ondigitalocean.com:25061

# ============================================
# S3 Cache (DigitalOcean Spaces)
# ============================================
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET_NAME=buglens-cache-staging
SPACES_ACCESS_KEY=DOxxxxxxxxxx
SPACES_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GitHub Integration
# ============================================
GITHUB_APP_ID=123456
GITHUB_APP_NAME=buglens-staging
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OpenAI
# ============================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Sentry
# ============================================
SENTRY_DSN=https://xxxxxxxx@o123456.ingest.sentry.io/789
SENTRY_ENVIRONMENT=staging

# ============================================
# Slack
# ============================================
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxx
SLACK_BOT_TOKEN=xoxb-xxxxx-xxxxx-xxxxxxxxxxxxx
SLACK_APP_ID=A0XXXXXXXXX

# ============================================
# Auth
# ============================================
JWT_SECRET=staging-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Feature Flags
# ============================================
FEATURE_LLM_ENABLED=true
FEATURE_SLACK_ENABLED=true
FEATURE_SOURCE_MAPS_ENABLED=true

# ============================================
# Datadog
# ============================================
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DD_ENV=staging
DD_SERVICE=buglens-api
DD_VERSION=${COMMIT_SHA}
